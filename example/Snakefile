# Layer 1. Snakemake, and nothing is added to it: it already records, per
# output, the input digests as sha256, the code, the shell command, the conda
# environment, a software-stack hash, and the times.
#
#   snakemake -n      # always first
#   snakemake -c1
#
# EVERY DATASET IS AN INPUT to the rules that describe it, even though they read
# the paths from `context.toml`. Consuming a file is what puts its sha256 into
# Snakemake's own store — Snakemake records a digest for every input and none
# for its outputs — so this is the whole receipt mechanism, delegated.
#
# The manually imported file is listed too. Snakemake cannot say where it came
# from, but once a rule consumes it, Snakemake does record the bytes that were
# read; `context.toml` pins the digest it is SUPPOSED to have, and
# `claimcheck.datasets` refuses to run if the two disagree.

import sys

PY = sys.executable


rule all:
    input:
        "results/croissant.json",
        "results/graph.ttl",


rule check_claims:
    input:
        data="data/mace_energies.csv",
        manual="data/experimental_affinity.csv",
        context="context.toml",
    output:
        "results/claims.json",
    params:
        py=PY,
    shell:
        "{params.py} -m claimcheck.relate . {output}"


rule croissant:
    input:
        data="data/mace_energies.csv",
        manual="data/experimental_affinity.csv",
        claims="results/claims.json",
        context="context.toml",
    output:
        "results/croissant.json",
    params:
        py=PY,
    shell:
        "{params.py} -m claimcheck.croissant . {output}"


# The only rule that needs the `graph` extra.
rule graph:
    input:
        croissant="results/croissant.json",
        claims="results/claims.json",
        context="context.toml",
    output:
        "results/graph.ttl",
    params:
        py=PY,
    shell:
        "{params.py} -m claimcheck.graph . {output}"
